# === Control Center v6 optional durable journal ===
# Use a PostgreSQL connection string. With Supabase/IPv4-only hosts, session pooler is usually appropriate.
JOURNAL_DATABASE_URL=
JOURNAL_SECRET=
JOURNAL_AUTO_RECOVER=1

# === Optional Passkey Panel Guard ===
# Leave 0 until durable journal is configured and you have tested v6 normally.
PANEL_GUARD_ENABLED=0
PANEL_SESSION_SECRET=
PANEL_SETUP_TOKEN=
PANEL_ALLOWED_ORIGINS=https://YOUR-SERVICE.onrender.com
PANEL_RP_ID=YOUR-SERVICE.onrender.com
PANEL_RP_NAME=Ninja Sage Control Center

# === Multi-character fairness ===
GLOBAL_ACTION_SPACING_SECONDS=1.25

# Existing optional settings still apply:
# REDIS_URL=
# BOT_STATE_SECRET=
# OTEL_ENABLED=0
